# Download the hpds release that generated this definition and verify its
# published checksum before copying it into the final image.
Bootstrap: docker
From: debian:trixie-slim
Stage: hpds

%post
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl
    rm -rf /var/lib/apt/lists/*

    case "$(uname -m)" in
        x86_64) target=x86_64 ;;
        aarch64) target=aarch64 ;;
        *) echo "unsupported architecture '$(uname -m)'; hpds supports x86_64 and aarch64" >&2; exit 1 ;;
    esac
    asset="hpds-${target}-unknown-linux-musl.tar.gz"
    release="https://github.com/StanfordHPDS/hpds-cli/releases/download/v{{hpds_version}}/$asset"
    cd /tmp
    curl --fail --location --retry 3 --output "$asset" "$release"
    curl --fail --location --retry 3 --output "$asset.sha256" "$release.sha256"
    sha256sum --check "$asset.sha256"
    tar -xzf "$asset"
    install -m 0755 "hpds-${target}-unknown-linux-musl/hpds" /hpds

Bootstrap: docker
From: ghcr.io/astral-sh/uv:{{uv_version}}
Stage: uv

# uv provisions the Python version declared by pyproject.toml / uv.lock.
Bootstrap: docker
From: debian:trixie-slim
Stage: final

%files from hpds
    /hpds /usr/local/bin/hpds

%files from uv
    /uv /usr/local/bin/uv
    /uvx /usr/local/bin/uvx

%files
    pyproject.toml /project/pyproject.toml
    uv.lock /project/uv.lock
{{python_version_apptainer_file}}

%post
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates git make
    rm -rf /var/lib/apt/lists/*

    export HOME=/project
    export UV_PROJECT_ENVIRONMENT=/project/.venv
    export UV_COMPILE_BYTECODE=1
    export UV_LINK_MODE=copy
    cd /project
    uv sync --locked --no-install-project

%environment
    export UV_PROJECT_ENVIRONMENT=/project/.venv
    export PATH="/project/.venv/bin:$PATH"

%runscript
    exec uv run "$@"

%labels
    Project {{project}}
    HPDS {{hpds_version}}
    UV {{uv_version}}
