# Download the hpds release that generated this definition and verify its
# published checksum before copying it into the final image.
Bootstrap: docker
From: debian:trixie-slim
Stage: hpds

%post
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl
    rm -rf /var/lib/apt/lists/*

    case "$(uname -m)" in
        x86_64) target=x86_64 ;;
        aarch64) target=aarch64 ;;
        *) echo "unsupported architecture '$(uname -m)'; hpds supports x86_64 and aarch64" >&2; exit 1 ;;
    esac
    asset="hpds-${target}-unknown-linux-musl.tar.gz"
    release="https://github.com/StanfordHPDS/hpds-cli/releases/download/v{{hpds_version}}/$asset"
    cd /tmp
    curl --fail --location --retry 3 --output "$asset" "$release"
    curl --fail --location --retry 3 --output "$asset.sha256" "$release.sha256"
    sha256sum --check "$asset.sha256"
    tar -xzf "$asset"
    install -m 0755 "hpds-${target}-unknown-linux-musl/hpds" /hpds

Bootstrap: docker
From: ghcr.io/astral-sh/uv:{{uv_version}}
Stage: uv

# R is pinned explicitly; uv provisions Python from the project metadata.
Bootstrap: docker
From: rocker/r-ver:{{r_version}}
Stage: final

%files from hpds
    /hpds /usr/local/bin/hpds

%files from uv
    /uv /usr/local/bin/uv
    /uvx /usr/local/bin/uvx

%files
    renv.lock /project/renv.lock
    .Rprofile /project/.Rprofile
    renv/activate.R /project/renv/activate.R
    renv/settings.json /project/renv/settings.json
{{renv_cellar_apptainer_file}}
    pyproject.toml /project/pyproject.toml
    uv.lock /project/uv.lock
{{python_version_apptainer_file}}

%post
    # R packages may need project-specific system libraries. Before building, run
    # renv::sysreqs(report = TRUE, collapse = TRUE) inside this base image, then
    # add the reported apt packages below so they are present before renv::restore():
    # https://rstudio.github.io/renv/articles/docker.html#system-dependencies
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        make
    rm -rf /var/lib/apt/lists/*

    export HOME=/project
    export RENV_PATHS_LIBRARY=/project/R-renv-library
    export RENV_CONFIG_CACHE_SYMLINKS=FALSE
    export UV_PROJECT_ENVIRONMENT=/project/.venv
    export UV_COMPILE_BYTECODE=1
    export UV_LINK_MODE=copy
    cd /project
    R -s -e 'renv::restore()'
    library_path="$(R -s -e 'cat(renv::paths$library())' | tail -n 1)"
    ln -s "$library_path" /project/R-library
    uv sync --locked --no-install-project

%environment
    export RENV_PATHS_LIBRARY=/project/R-renv-library
    export R_LIBS_SITE=/project/R-library
    export RENV_CONFIG_AUTOLOADER_ENABLED=FALSE
    export RENV_CONFIG_CACHE_SYMLINKS=FALSE
    export UV_PROJECT_ENVIRONMENT=/project/.venv
    export PATH="/project/.venv/bin:$PATH"

%runscript
    exec "$@"

%labels
    Project {{project}}
    HPDS {{hpds_version}}
    UV {{uv_version}}
    R {{r_version}}
